# Set the RPC URL for each chain selected in your w3plex.yaml.
ETH_RPC_URL=https://your-ethereum-rpc.example
# OPTIMISM_RPC_URL=https://your-optimism-rpc.example
# BNB_RPC_URL=https://your-bnb-rpc.example
# POLYGON_RPC_URL=https://your-polygon-rpc.example
# ARBITRUM_RPC_URL=https://your-arbitrum-rpc.example
# ZKSYNC_RPC_URL=https://your-zksync-rpc.example

# Optional DeBank OpenAPI access key.
# DEBANK_ACCESS_KEY=your-access-key

# Optional keystore location; default is ~/.keystore.bin.
# W3PLEX_KEYSTORE=/absolute/path/to/.keystore.bin
